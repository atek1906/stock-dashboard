# Stockwise environment variables
#
# yahoo-finance2 needs no API key — data is fetched anonymously server-side.
# These knobs are optional; sensible defaults are used when unset.

# Public app name shown in the navbar.
NEXT_PUBLIC_APP_NAME="Stockwise"

# Client auto-refresh interval for React Query, in milliseconds (default 5 min).
NEXT_PUBLIC_REFRESH_MS=300000

# Server-side cache window for API route data, in seconds (default 5 min).
DATA_REVALIDATE_SECONDS=300
